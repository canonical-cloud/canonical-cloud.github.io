# Copy to .env for local `npm run dev`. Only /prices/ reads these.
PUBLIC_CANONICAL_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_CANONICAL_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# The accepted one-time code for the pricing gate (soft gate; inlined into the /prices/ bundle).
PUBLIC_PRICES_OTP=
