---
import BaseLayout from '../../layouts/BaseLayout.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';
const priceFunction = import.meta.env.PUBLIC_CANONICAL_PRICING_FUNCTION ?? 'canonical-prices';
const configured = Boolean(supabaseUrl && supabaseKey && priceFunction);
---
<BaseLayout
  title="Canonical Cloud — Service pricing"
  description="Email-verified access to proposed Canonical Cloud managed-readiness service tiers."
>
  <section class="price-hero shell">
    <div class="price-intro">
      <p class="eyebrow">Service pricing</p>
      <h1>Verify your email to view the current proposed service tiers.</h1>
      <p class="lede">
        Pricing is intentionally separated from the public marketing page. The authenticated catalog is the
        same governed data our Service Level Agreement, support addendum and Statement of Work packages are
        rendered from — three tiers, three price points, one source; a signed Statement of Work or Order Form
        controls actual scope, fees, term, and billing.
      </p>
    </div>

    <div class="price-gate" data-configured={configured ? 'true' : 'false'}>
      <div id="configuration-error" class="gate-message error" hidden>
        Pricing access is not configured for this deployment. The build must provide the approved public
        Supabase URL and publishable key.
      </div>

      <form id="email-form" class="gate-card">
        <p class="step">Step 1 of 2</p>
        <h2>Send a one-time code</h2>
        <label for="price-email">Work email</label>
        <input id="price-email" name="email" type="email" autocomplete="email" required />
        <button class="button" type="submit">Email me a code</button>
        <p class="fine-print">
          Supabase Auth sends the sign-in message; no password is created and nothing else is stored on this site.
          The project email template must use the OTP token form rather than a magic link. Requests are subject to
          the project’s authentication rate limits.
        </p>
      </form>

      <form id="otp-form" class="gate-card" hidden>
        <p class="step">Step 2 of 2</p>
        <h2>Enter the code</h2>
        <label for="price-otp">One-time code</label>
        <input id="price-otp" name="otp" inputmode="numeric" autocomplete="one-time-code" minlength="6" required />
        <button class="button" type="submit">Verify and view pricing</button>
        <button id="change-email" class="text-button" type="button">Use a different email</button>
      </form>

      <p id="gate-status" class="gate-message" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section id="pricing-content" class="section shell" hidden aria-live="polite">
    <div class="section-heading">
      <p class="eyebrow">Verified catalog</p>
      <h2>Proposed starting prices</h2>
      <p id="pricing-boundary">
        These are planning/list-price starting points. They are not an offer, audit opinion, certification,
        attestation, or authorization. The signed SOW controls the customer engagement.
      </p>
    </div>
    <div id="price-grid" class="price-grid"></div>
    <div class="section-heading sub"><p class="eyebrow">Statement of Work packages</p><h2>Fixed scope, fixed fee, written down before we start.</h2></div>
    <div id="sow-grid" class="price-grid"></div>
    <div class="section-heading sub"><p class="eyebrow">Support targets</p><h2>The same table your SLA uses.</h2></div>
    <div class="table-wrap"><table class="support-table"><thead><tr><th>Tier</th><th>Coverage</th><th>P1 first response</th><th>P2</th><th>P3</th></tr></thead><tbody id="support-body"></tbody></table></div>
    <ul id="non-reliance" class="non-reliance"></ul>
    <p id="provenance" class="fine-print"></p>
  </section>

  <noscript>
    <section class="section shell"><p>JavaScript is required for email verification and authenticated pricing.</p></section>
  </noscript>

  <script define:vars={{ supabaseUrl, supabaseKey, priceFunction, configured }}>
    const emailForm = document.querySelector('#email-form');
    const otpForm = document.querySelector('#otp-form');
    const emailInput = document.querySelector('#price-email');
    const otpInput = document.querySelector('#price-otp');
    const status = document.querySelector('#gate-status');
    const changeEmail = document.querySelector('#change-email');
    const content = document.querySelector('#pricing-content');
    const grid = document.querySelector('#price-grid');
    const sowGrid = document.querySelector('#sow-grid');
    const supportBody = document.querySelector('#support-body');
    const nonReliance = document.querySelector('#non-reliance');
    const provenance = document.querySelector('#provenance');
    const configError = document.querySelector('#configuration-error');
    let pendingEmail = '';

    const setStatus = (message, isError = false) => {
      status.textContent = message;
      status.classList.toggle('error', isError);
    };

    const request = async (path, options = {}) => {
      const response = await fetch(`${supabaseUrl}${path}`, {
        ...options,
        headers: {
          apikey: supabaseKey,
          'content-type': 'application/json',
          ...(options.headers ?? {}),
        },
      });
      let body = {};
      try { body = await response.json(); } catch { body = {}; }
      if (!response.ok) {
        const message = body?.msg ?? body?.message ?? body?.error_description ?? body?.error ?? `request_failed_${response.status}`;
        throw new Error(String(message));
      }
      return body;
    };

    const usd = (n) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(n);
    const el = (tag, className, text) => { const node = document.createElement(tag); if (className) node.className = className; if (text !== undefined) node.textContent = text; return node; };
    const list = (tag, items) => { const node = document.createElement(tag); for (const item of items) node.append(el('li', '', String(item))); return node; };

    // The function returns the governed ServiceTierCatalog from
    // canonical-cloud/canonical-docs (data/legal/service-tiers.json): the same
    // data the SLA, support addendum, SOW package menu and pricing schedule
    // are rendered from. Anything that does not look like it is rejected.
    const renderPricing = (catalog) => {
      if (!catalog || typeof catalog.schemaVersion !== 'string' || !Array.isArray(catalog.tiers) || catalog.tiers.length < 3) {
        throw new Error('pricing_contract_mismatch');
      }
      const support = new Map((catalog.supportTiers ?? []).map((s) => [s.id, s]));
      const sows = new Map((catalog.sowPackages ?? []).map((s) => [s.id, s]));
      grid.replaceChildren();
      for (const tier of catalog.tiers) {
        if (!tier || typeof tier.name !== 'string' || !Number.isFinite(tier.monthlyPriceUsd)) {
          throw new Error('pricing_tier_invalid');
        }
        const card = el('article', 'price-card');
        card.append(el('p', 'step', `Tier ${tier.rank ?? ''}`), el('h3', '', tier.name), el('p', 'tagline', tier.tagline ?? ''));
        card.append(el('p', 'price', `${usd(tier.monthlyPriceUsd)} / month`));
        if (Number.isFinite(tier.annualPriceUsd)) card.append(el('p', 'price-alt', `${usd(tier.annualPriceUsd)} / year paid annually · ${tier.minimumTermMonths}-month minimum`));
        const facts = el('dl', 'tier-facts');
        const s = support.get(tier.supportTierId);
        for (const [k, v] of [
          ['Support', s ? `${s.name} — ${s.coverage}` : '—'],
          ['Availability commitment', `${tier.availabilityCommitmentPercent}% per month`],
          ['Frameworks', tier.includedFrameworks],
          ['Seats', tier.includedSeats],
          ['Evidence connectors', tier.includedConnectors],
          ['Managed operations', tier.managedOperationsHoursPerMonth ? `${tier.managedOperationsHoursPerMonth} hours / month` : 'Not included'],
          ['Evidence retention', `${tier.evidenceRetentionMonths} months`],
        ]) { const row = el('div'); row.append(el('dt', '', k), el('dd', '', String(v))); facts.append(row); }
        card.append(facts, el('p', 'cadence', tier.audience ?? ''), list('ul', tier.features ?? []));
        if (Array.isArray(tier.notIncluded) && tier.notIncluded.length) card.append(el('p', 'fine-print', `Not included: ${tier.notIncluded.join('; ')}.`));
        const sow = sows.get(tier.sowPackageId);
        if (sow) card.append(el('p', 'fine-print', `Bundled package: ${sow.name} — ${usd(sow.fixedFeeUsd)} fixed, ${sow.durationWeeks} weeks`));
        grid.append(card);
      }
      sowGrid.replaceChildren();
      for (const sow of catalog.sowPackages ?? []) {
        const card = el('article', 'price-card');
        card.append(el('p', 'step', sow.id), el('h3', '', sow.name), el('p', 'price-alt', `${usd(sow.fixedFeeUsd)} fixed · ${sow.durationWeeks} weeks`), el('p', '', sow.summary ?? ''));
        card.append(el('strong', '', 'Deliverables'), list('ol', sow.deliverables ?? []), el('strong', '', 'Out of scope'), list('ul', sow.outOfScope ?? []));
        sowGrid.append(card);
      }
      supportBody.replaceChildren();
      for (const s of catalog.supportTiers ?? []) {
        const row = el('tr');
        for (const v of [s.name, s.coverage, s.initialResponse?.p1, s.initialResponse?.p2, s.initialResponse?.p3]) row.append(el('td', '', String(v ?? '')));
        supportBody.append(row);
      }
      nonReliance.replaceChildren(...(catalog.nonReliance ?? []).map((line) => el('li', '', String(line))));
      provenance.textContent = catalog.sourcePath ? `Catalog ${catalog.catalogVersion ?? ''}, effective ${catalog.effectiveDate ?? ''}, from ${catalog.sourcePath} in ${catalog.sourceRepository ?? ''}. Assessor, certification-body, QSA and 3PAO fees are contracted and paid by you directly.` : '';
      content.hidden = false;
      emailForm.hidden = true;
      otpForm.hidden = true;
      setStatus('Email verified. Pricing loaded from the authenticated catalog.');
      content.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    if (!configured) {
      configError.hidden = false;
      emailForm.hidden = true;
      setStatus('Pricing authentication is unavailable in this deployment.', true);
    } else {
      emailForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        pendingEmail = emailInput.value.trim().toLowerCase();
        if (!pendingEmail) return;
        setStatus('Sending one-time code…');
        try {
          await request('/auth/v1/otp', {
            method: 'POST',
            body: JSON.stringify({ email: pendingEmail, create_user: true }),
          });
          emailForm.hidden = true;
          otpForm.hidden = false;
          otpInput.focus();
          setStatus(`Code sent to ${pendingEmail}.`);
        } catch (error) {
          setStatus(`Could not send code: ${error.message}`, true);
        }
      });

      otpForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        const token = otpInput.value.trim();
        if (!pendingEmail || !token) return;
        setStatus('Verifying code…');
        try {
          const session = await request('/auth/v1/verify', {
            method: 'POST',
            body: JSON.stringify({ email: pendingEmail, token, type: 'email' }),
          });
          const accessToken = session.access_token ?? session.session?.access_token;
          if (typeof accessToken !== 'string' || accessToken.length < 20) {
            throw new Error('verified_session_missing');
          }
          const catalog = await request(`/functions/v1/${encodeURIComponent(priceFunction)}`, {
            method: 'GET',
            headers: { authorization: `Bearer ${accessToken}` },
          });
          renderPricing(catalog);
        } catch (error) {
          setStatus(`Verification failed: ${error.message}`, true);
        } finally {
          otpInput.value = '';
        }
      });

      changeEmail.addEventListener('click', () => {
        pendingEmail = '';
        otpInput.value = '';
        otpForm.hidden = true;
        emailForm.hidden = false;
        setStatus('');
        emailInput.focus();
      });
    }
  </script>
</BaseLayout>

<style>
  .price-hero { padding: 7rem 0 3rem; display: grid; grid-template-columns: 1.1fr .9fr; gap: 4rem; align-items: start; }
  .price-intro h1 { max-width: 14ch; }
  .price-gate { position: relative; }
  .gate-card { display: grid; gap: 1rem; padding: 2rem; background: white; border: 1px solid rgba(7,19,38,.12); border-radius: 1.25rem; box-shadow: 0 24px 70px rgba(29,78,216,.09); }
  .gate-card h2 { margin: 0; }
  .step { margin: 0; font-size: .78rem; text-transform: uppercase; letter-spacing: .13em; font-weight: 800; color: var(--accent); }
  label { font-weight: 700; }
  input { width: 100%; border: 1px solid rgba(7,19,38,.22); border-radius: .75rem; padding: .9rem 1rem; font: inherit; background: #fff; color: var(--ink); }
  input:focus { outline: 3px solid rgba(29,78,216,.2); border-color: var(--accent); }
  .fine-print { font-size: .84rem; line-height: 1.55; opacity: .72; margin: 0; }
  .gate-message { margin: 1rem 0 0; min-height: 1.5rem; }
  .gate-message.error { color: #991b1b; }
  .text-button { background: none; border: 0; padding: 0; color: var(--accent); text-decoration: underline; cursor: pointer; justify-self: start; font: inherit; }
  .price-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1.25rem; }
  .price-card { padding: 1.6rem; background: white; border: 1px solid rgba(7,19,38,.12); border-radius: 1rem; }
  .price-card h3 { margin-top: 0; }
  .price { font-size: 1.55rem; font-weight: 850; letter-spacing: -.03em; color: var(--accent); }
  .cadence { font-weight: 650; }
  .price-card li { margin-bottom: .6rem; line-height: 1.45; }
  .price-alt, .tagline { margin: 0; opacity: .72; font-size: .92rem; }
  .tier-facts { display: grid; gap: .35rem; margin: .8rem 0; padding: .8rem 0; border-block: 1px solid rgba(7,19,38,.12); font-size: .9rem; }
  .tier-facts div { display: flex; justify-content: space-between; gap: 1rem; }
  .tier-facts dt { opacity: .7; } .tier-facts dd { margin: 0; text-align: right; font-weight: 700; }
  .section-heading.sub { margin-top: 3rem; }
  .table-wrap { overflow-x: auto; margin-top: 1.5rem; }
  .support-table { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .support-table th, .support-table td { padding: .7rem .8rem; border-bottom: 1px solid rgba(7,19,38,.12); text-align: left; vertical-align: top; }
  .non-reliance { margin: 2rem 0 0; padding-left: 1.1rem; line-height: 1.6; opacity: .8; }
  @media (max-width: 820px) { .price-hero, .price-grid { grid-template-columns: 1fr; } .price-hero { gap: 2rem; padding-top: 4rem; } }
</style>
