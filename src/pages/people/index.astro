---
import BaseLayout from '../../layouts/BaseLayout.astro';

const people = [
  { name: 'Alexander Mills', role: 'Integrations & DevOps' },
  { name: 'John Siliciano', role: 'DevOps / Security / Infrastructure' },
  { name: 'Jack Johnson', role: 'Browser / Mobile / Clientside' },
  { name: 'Vikkie Pandey', role: 'Marketing & Sales' },
  { name: 'Elijah Gizzarelli', role: 'Operations & HR' },
  { name: 'Marcus Gerlach', role: 'Engineering' },
  { name: 'Eugene Li', role: 'CPA & Legal' },
  { name: 'Tom Mensch', role: 'Software & Legal' },
  { name: 'Sam Stone', role: 'Accounts & Sales' },
  { name: 'Cody Dyson', role: 'Sales Engineer' },
];
---
<BaseLayout title={`People — Canonical Cloud`} description={`Meet the people working across engineering, operations, sales, legal, and infrastructure at Canonical Cloud.`}>
  <section class="page-hero shell">
    <p class="eyebrow">People</p>
    <h1>The people behind Canonical Cloud.</h1>
    <p>Cross-functional experience across engineering, infrastructure, operations, sales, marketing, accounting, and legal.</p>
  </section>
  <section class="section shell">
    <div class="card-grid">
      {people.map((person) => (
        <article class="card">
          <span>Team</span>
          <h2>{person.name}</h2>
          <p>{person.role}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
